{
  "manifest_version": 3,
  "name": "Markdown Capture",
  "version": "0.6.1",
  "description": "Capture supported web content as clean Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_title": "Capture as Markdown",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "copy-selection-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Option+Shift+M"
      },
      "description": "Copy the current selection as Markdown"
    }
  }
}
