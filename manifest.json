{
  "manifest_version": 3,
  "name": "Markdown Capture",
  "version": "0.7.0",
  "description": "Capture supported web content as clean Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture as Markdown",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "copy-selection-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Option+Shift+M"
      },
      "description": "Copy the current selection as Markdown"
    }
  }
}
