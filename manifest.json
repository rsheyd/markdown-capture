{
  "manifest_version": 3,
  "name": "Markdown Capture",
  "version": "0.3.0",
  "description": "Capture supported web content as clean Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_title": "Capture as Markdown",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
